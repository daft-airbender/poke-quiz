{
  "name": "poke-quiz",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Pokémon quiz app: names, types, and type matchups.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "fetch:pokemon": "node scripts/fetch-pokemon.js",
    "build:palettes": "node scripts/build-palettes.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "create-user": "node --env-file=.env scripts/create-user.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cookie-session": "2.1.1",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "htm": "3.1.1",
    "pg": "8.23.1",
    "preact": "11.1.0"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "pngjs": "7.0.0"
  }
}
